# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: meta | twilio
WHATSAPP_PROVIDER=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# Configurar en: https://developers.facebook.com
#
# Los números de WhatsApp ("canales") se administran desde el panel
# (Gestión → Canales de WhatsApp) una vez desplegado — no hace falta tocar
# variables de entorno para agregar uno nuevo. Las variables de abajo SOLO
# se usan la primera vez que arranca el servidor, si la tabla de canales
# está vacía, para no perder una instalación que ya venía configurada así.
#
# Un solo número:
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_APP_SECRET=
#
# Dos o más números (ej. pruebas + producción) — repite el bloque con
# META_CANAL_2_*, META_CANAL_3_*, etc.:
# META_CANAL_1_NOMBRE=Cálidda - Pruebas
# META_CANAL_1_PHONE_NUMBER_ID=
# META_CANAL_1_ACCESS_TOKEN=
# META_CANAL_1_APP_SECRET=
# META_CANAL_2_NOMBRE=Cálidda - Producción
# META_CANAL_2_PHONE_NUMBER_ID=
# META_CANAL_2_ACCESS_TOKEN=
# META_CANAL_2_APP_SECRET=
#
# Verify Token para la verificación GET del webhook (uno solo, no por canal):
# META_VERIFY_TOKEN=agentkit-verify

# ── Cifrado de los canales de WhatsApp guardados en la base de datos ──
# Obligatorio si vas a tener al menos un canal (siempre, en la práctica).
# Los access_token/app_secret de cada canal se guardan CIFRADOS en la BD
# (a diferencia del resto de credenciales del proyecto, que solo viven en
# variables de entorno) — esta es la clave de cifrado. Generar UNA vez y
# guardarla igual que cualquier otro secreto (si se pierde/cambia, los
# canales ya guardados quedan ilegibles y hay que volver a cargarlos):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CANAL_ENCRYPTION_KEY=

# ── Leads de formulario de Meta (Lead Ads/Instant Forms) ──
# Opcional — solo si además de WhatsApp quieres traer leads que llenan un
# formulario en Facebook/Instagram (nunca escriben primero por WhatsApp).
# Token de la PÁGINA con permiso leads_retrieval — distinto del access
# token del número de WhatsApp. Se configura por canal (campo "Page Access
# Token" al crear/editar un canal en el panel); META_PAGE_ACCESS_TOKEN /
# META_CANAL_N_PAGE_ACCESS_TOKEN de abajo solo aplican a la siembra inicial.
# META_PAGE_ACCESS_TOKEN=
# Nombre exacto de la plantilla de WhatsApp ya APROBADA por Meta — es
# obligatoria para poder mandarle el primer mensaje a alguien que nunca
# escribió (WhatsApp no permite texto libre en ese caso). Si se deja vacío,
# el lead igual se crea en el panel, pero nadie le escribe automáticamente.
# META_LEADGEN_TEMPLATE_NAME=
# META_LEADGEN_TEMPLATE_LANG=es

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Configurar en: https://twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Notificaciones al equipo comercial (Resend) ────────────
# Obtener en: https://resend.com/api-keys
# RESEND_API_KEY=
# NOTIFICACION_REMITENTE=
# NOTIFICACION_DESTINATARIOS=

# ── Panel interno (/dashboard) ─────────────────────────────
# Los usuarios y contraseñas viven en la base de datos (tabla `usuarios`,
# contraseñas encriptadas con bcrypt), no aquí. Ver agent/memory.py:crear_usuario.
# SESSION_SECRET_KEY firma la cookie de sesión del login — generar un valor
# largo y aleatorio propio (no reusar el de otro entorno).
SESSION_SECRET_KEY=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway) — Railway la genera solo al agregar el
# plugin de Postgres al proyecto, normalmente como ${{Postgres.DATABASE_URL}}:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Archivos adjuntos (proformas/catálogos enviados por asesores) ─────
# Local: una carpeta normal alcanza (default: data/archivos, no hace falta
# declarar esta variable). Produccion (Railway): debe apuntar al punto de
# montaje de un Volume persistente — el disco del contenedor es efímero,
# se pierde en cada redeploy.
# ARCHIVOS_DIR=/data/archivos

# ── Backup de la base de datos (scripts/backup_postgres.py, ADR-0001) ──
# El plan de Railway contratado no incluye backups nativos de Postgres ni
# Point-in-Time Recovery — este script los reemplaza subiendo un pg_dump
# a almacenamiento S3-compatible (AWS S3, Cloudflare R2, Backblaze B2,
# etc. — cualquiera que hable la API de S3). Solo hace falta en el
# servicio de Cron Schedule que corre el backup, no en el proceso web.
# S3_ENDPOINT_URL=https://<tu-endpoint-s3-compatible>
# S3_BUCKET=agentkit-backups
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# BACKUP_RETENCION_DIAS=30
